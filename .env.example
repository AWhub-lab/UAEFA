# Do not commit a real .env file. Share the Drive root folder with this
# service-account email as Viewer. Publishing uses the owner's OAuth account.
GOOGLE_DRIVE_ROOT_ID=replace-with-your-drive-root-folder-id
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'
# Used only by the local publisher so uploads use the owner's Drive quota.
GOOGLE_OAUTH_CLIENT_SECRET_PATH=client_secret_your-client-id.apps.googleusercontent.com.json
# Optional for a locally protected preview. Configure the hosting password as a
# secret instead of committing it here.
APP_PASSWORD=replace-with-a-strong-private-password
